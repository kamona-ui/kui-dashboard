{
  "private": true,
  "type": "module",
  "scripts": {
    "dev:tw": "pnpm --filter @kui-dashboard/tailwindcss-plugin dev",
    "dev:alpine": "pnpm --filter @kui-dashboard/alpinejs-plugin dev",
    "dev:alpine:css": "pnpm --filter @kui-dashboard/alpinejs-plugin dev:css",
    "dev:vue-plugin": "pnpm --filter @kui-dashboard/vue-plugin dev",
    "dev:home": "pnpm --filter home-page dev",
    "dev:html": "pnpm --filter kui-dashboard-html dev",
    "dev:vue": "pnpm --filter kui-dashboard-vue dev",
    "build:tw": "pnpm --filter @kui-dashboard/tailwindcss-plugin build",
    "build:alpine": "pnpm --filter @kui-dashboard/alpinejs-plugin build",
    "build:alpine:css": "pnpm --filter @kui-dashboard/alpinejs-plugin build:css",
    "build:vue-plugin": "pnpm --filter @kui-dashboard/vue-plugin build",
    "build:vue-plugin:css": "pnpm --filter @kui-dashboard/vue-plugin build:css",
    "build:home": "pnpm --filter home-page build",
    "build:html": "pnpm --filter kui-dashboard-html build",
    "build:vue": "pnpm --filter kui-dashboard-vue build",
    "preview:home": "pnpm --filter home-page preview",
    "preview:html": "pnpm --filter kui-dashboard-html preview",
    "preview:vue": "pnpm --filter kui-dashboard-vue preview",
    "format:home": "pnpm --filter home-page format",
    "format:html": "pnpm --filter kui-dashboard-html format",
    "format:vue": "pnpm --filter kui-dashboard-vue format",
    "predev:home": "run-s build:tw build:vue-plugin",
    "predev:html": "run-s build:tw build:alpine build:alpine:css",
    "predev:vue": "run-s build:tw build:vue-plugin",
    "prebuild": "rimraf dist",
    "build": "run-s build:*",
    "postbuild": "node scripts/copy-templates",
    "preview": "node scripts/preview",
    "deploy": "gh-pages -d dist",
    "format": "prettier --write \"templates\" \"plugins\"",
    "commit": "commit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/prompt-cli": "^19.7.0",
    "express": "^4.21.2",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rimraf": "^6.0.1"
  }
}
